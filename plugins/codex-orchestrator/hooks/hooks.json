        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/orchestrator-hook.mjs\"",
            "statusMessage": "Checking Codex Orchestrator completion standard"
          }
        ]
      }
    ]
  }
}
