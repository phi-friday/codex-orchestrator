{
  "name": "codex-orchestrator",
  "private": true,
  "author": {
    "name": "phi",
    "email": "phi.friday@gmail.com",
    "url": "https://github.com/phi-friday/codex-orchestrator"
  },
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "typecheck": "tsc",
    "lint": "oxlint --config oxlint.config.ts",
    "test": "bun test ./plugins ./scripts --concurrent --max-concurrency 4",
    "format": "oxfmt --config oxfmt.config.ts",
    "version": "bun scripts/version.ts",
    "version:check": "bun scripts/version.ts --check",
    "reference:oh-my-opencode-slim": "bun scripts/reference-oh-my-opencode-slim.ts --version $(bun reference:oh-my-opencode-slim:version)",
    "reference:oh-my-opencode-slim:version": "jq -r '.references[\"oh-my-opencode-slim\"].version' package.json"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "oxfmt": "0.50.0",
    "oxlint": "1.65.0",
    "oxlint-tsgolint": "0.22.1"
  },
  "peerDependencies": {
    "typescript": "6.0.3"
  },
  "references": {
    "oh-my-opencode-slim": {
      "version": "1.1.1"
    }
  }
}
